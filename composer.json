{
    "name": "alveby/atrium-ai",
    "description": "AI for Atrium: generate descriptions, previews, SEO tags, alt text and translations with any provider of the Laravel AI SDK",
    "type": "atrium-module",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "ai",
        "llm",
        "gemini",
        "ollama",
        "seo",
        "i18n"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.1",
        "laravel/ai": "^1.4"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Ai\\Tests\\": "tests/"
        }
    },
    "extra": {
        "atrium": {
            "migrations": "database/migrations",
            "title": "atrium-ai::ai.settings.module",
            "settings": "Atrium\\Ai\\AiSettings"
        },
        "laravel": {
            "providers": [
                "Atrium\\Ai\\AiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
